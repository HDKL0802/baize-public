<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.baize.todo"
    android:versionCode="1012"
    android:versionName="0.10.12">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 通知（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 按住说话：网页里用 getUserMedia 录音，再由后端听写成文字 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 精确闹钟（Android 12+ 需用户授权；未授权时自动退化为普通闹钟） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 支持在对话里直接 @路径 读文件（需用户在系统设置里开启"所有文件访问"） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 跨端内核常驻：前台服务（Android 9+ 需 FOREGROUND_SERVICE；Android 14+ 按类型再声明 dataSync） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 11+ 的包可见性：不声明就"看不见"相机和文件选择器 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
    </queries>

    <application
        android:debuggable="true"
        android:label="白泽"
        android:icon="@drawable/ic_launcher"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="com.baize.todo.MainActivity"
            android:exported="true"
            android:label="白泽"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按图标的快捷菜单 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 待办附件的对外只读通道：附件存在私有目录，必须用 content:// 才能交给相册/WPS 打开 -->
        <provider
            android:name="com.baize.todo.AttProvider"
            android:authorities="com.baize.todo.att"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 跨端内核常驻服务：让设备长期在线（划掉 App / 重启 / 覆盖安装后都能自己回来） -->
        <service
            android:name="com.baize.todo.CoreService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 闹钟到点弹通知 -->
        <receiver
            android:name="com.baize.todo.ReminderReceiver"
            android:exported="false" />

        <!-- 桌面语音小组件与录音转写已移除：语音输入改由用户自己的输入法完成 -->

        <!-- 开机 / 覆盖安装后重建闹钟 + 拉起跨端常驻服务。
             高 priority：BOOT_COMPLETED 是顺序广播，三星等 OEM 的省电策略可能在派发到我们之前就强停 App，
             提高优先级能更早拿到这次广播（抢不到就等用户打开 App，见 CoreService 注释）。 -->
        <receiver
            android:name="com.baize.todo.BootReceiver"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
