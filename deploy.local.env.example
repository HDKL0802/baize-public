# Local deploy credentials (template).
# Copy this file to deploy.local.env and fill in real values.
# deploy.local.env is git-ignored -- never commit it.
#
# NOTE: keep this file ASCII-only. PowerShell 5.1 reads it as ANSI/GBK by default;
# non-ASCII comment bytes can swallow the following newline and hide the next key.

BAIZE_NAS_HOST=192.168.1.100
BAIZE_NAS_USER=<NAS ssh user>
BAIZE_NAS_PASS=<NAS ssh password>
BAIZE_TOKEN=<the token string in the backend data dir>